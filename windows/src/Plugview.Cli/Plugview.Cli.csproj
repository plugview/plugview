<Project Sdk="Microsoft.NET.Sdk">
  <!-- plugview.exe: the command on Windows (the MSIX alias `plugview` in phase 6.5), and the phase 6.2 latency spike. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>plugview</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Plugview.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>../Plugview.Windows/Assets/plugview.ico</ApplicationIcon>
    <ApplicationManifest>../Plugview.Windows/Assets/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Plugview.Core/Plugview.Core.csproj" />
    <ProjectReference Include="../Plugview.Windows/Plugview.Windows.csproj" />
  </ItemGroup>
</Project>
