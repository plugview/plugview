<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows capture, display and audio: Media Foundation → Direct3D 11 → DXGI flip-model swap chain, and WASAPI
       card audio with drift correction. Builds on any OS (EnableWindowsTargeting); runs on Windows 10 19041+. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Plugview.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Plugview.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plugview.Core/Plugview.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
