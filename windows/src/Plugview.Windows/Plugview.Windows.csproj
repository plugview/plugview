<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows capture, display and audio: Media Foundation → Direct3D 11 → DXGI flip-model swap chain, and WASAPI
       card audio with drift correction. Builds on any OS (EnableWindowsTargeting); runs on Windows 10 19041+. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Plugview.Windows</RootNamespace>
    <!-- Structures whose layout depends on the pointer size (NOTIFYICONDATAW) as on every 64-bit Windows (x64, Arm64). -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Plugview.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Geist and Geist Mono (SIL OFL), the same files the Mac bundles; DirectWrite reads them from memory. -->
    <EmbeddedResource Include="../../../Sources/PlugviewUI/Fonts/*.ttf" LogicalName="Plugview.Windows.Fonts.%(Filename)%(Extension)" />
    <!-- Tray icons (windows/scripts/icons.sh); the app icon goes into the executables as a Win32 resource. -->
    <EmbeddedResource Include="Assets/tray-*.ico" LogicalName="Plugview.Windows.Assets.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plugview.Core/Plugview.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
